{
  "name": "dcn-simulator",
  "version": "1.4.0",
  "description": "Digital China DCN network simulator (Packet Tracer-like, CLI aligned with the course PPT and lab reports)",
  "author": "furryxuantao",
  "license": "MIT",
  "homepage": "https://github.com/furryxuantao/dcn-switchport",
  "repository": {
    "type": "git",
    "url": "https://github.com/furryxuantao/dcn-switchport.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "cn.dcn.simulator",
    "productName": "DCN Network Simulator",
    "copyright": "Copyright © 2026 furryxuantao",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "main.js",
          "preload.js",
          "package.json"
        ]
      },
      {
        "from": "..",
        "to": ".",
        "filter": [
          "index.html",
          "styles.css",
          "README.md",
          "src/**/*",
          "assets/icons/*.svg"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "../assets/icon.ico",
      "artifactName": "DCN-Network-Simulator-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "DCN-Network-Simulator-${version}-portable.${ext}",
      "unicode": false,
      "requestExecutionLevel": "user"
    }
  }
}